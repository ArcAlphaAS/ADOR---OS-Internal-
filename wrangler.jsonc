// Cloudflare Workers config for ADOR OS. Built from GitHub by Workers
// Builds: build command `npm run build`, deploy command `npx wrangler deploy`.
// Env: VITE_* go in the *build* variables (Vite bakes them into the app);
// VITE_GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET also go in the Worker's
// runtime Variables and Secrets (the /api handlers read them).
{
  "name": "ador-os",
  "main": "server/worker.js",
  "compatibility_date": "2026-09-01",
  // Keep the variables set in the Cloudflare dashboard on every deploy.
  "keep_vars": true,
  // The free public address, ador-os.<account>.workers.dev — ADOR OS's main
  // URL (independent of any paid domain). Preview URLs for other branches.
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Notificaciones push (server/push.js). Public values only — the matching
  // VAPID_PRIVATE_KEY is a Secret in Cloudflare (Settings → Variables and
  // Secrets). Changing the key pair means every device turns notifications
  // on again.
  "vars": {
    "FIREBASE_PROJECT_ID": "ador-os",
    "VAPID_PUBLIC_KEY": "BHYH4vo4RAKIcQQtYvfIvgUq3Yl1IXKEl9vKnT6c-ZMGYjkWKVERgAxQcSNTDgQ7w6YE8ezAjNJdMN1iJm3dKYo",
    "VAPID_SUBJECT": "https://ador-os.adorfirm.workers.dev"
  },
  "observability": { "enabled": true }
}
