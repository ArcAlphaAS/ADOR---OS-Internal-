# ADOR IA — deliberately NOT prefixed with VITE_. A VITE_ var gets compiled
# into the client bundle and is readable by anyone in devtools; this one is
# only read by api/ador-ia.js, a Vercel serverless function, so it never
# reaches the browser. Get a free key (no card) at aistudio.google.com.
GEMINI_API_KEY=
