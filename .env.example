VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ADOR IA — deliberately NOT prefixed with VITE_. A VITE_ var gets compiled
# into the client bundle and is readable by anyone in devtools; this one is
# only read by api/ador-ia.js, a Vercel serverless function, so it never
# reaches the browser. Get a free key (no card) at aistudio.google.com.
GEMINI_API_KEY=

# Calendario (Google Calendar, read-only) — from Google Cloud Console →
# APIs & Services → Credentials, after enabling the Calendar API and
# configuring the OAuth consent screen (External, Testing, with the
# founders' emails added as test users). The client ID is NOT secret (it's
# fine in the bundle, hence VITE_); the client secret must never get a
# VITE_ prefix — only api/google-calendar/*.js ever reads it.
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
